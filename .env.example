# ── Copy to .env and adjust. docker-compose reads this automatically. ──

# Host root mounted into the api as /host. The watched folder is a SUBFOLDER of
# this — chosen by the `watchSubdir` setting, editable live from the frontend.
WATCH_ROOT=${HOME}
# Initial watched subfolder under WATCH_ROOT (seeds the DB on first run).
# e.g. "Downloads" or "Downloads/PDFs". Watched path = /host/<WATCH_SUBDIR>.
WATCH_SUBDIR=Downloads/PDFs

# Where Markdown, metadata, archived PDFs and the SQLite index live.
VAULT_DIR=./vault

# The app (nginx serving the SPA + proxying to the api). Open this in a browser.
WEB_PORT=6669
# Direct API + Scalar explorer (the SPA does not need this).
API_PORT=6670

# ── These seed the settings table on first run; edit them live from the UI after. ──
# Host Ollama (Vulkan). Must be reachable from the container — see README.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Seconds a new file's size must stay stable before processing (defeats .crdownload).
DEBOUNCE_SECONDS=2

# marker-server (internal service DNS). Container shape — not a live setting.
MARKER_URL=http://marker-server:8000

# Set to "cuda" only after ROCm is proven on gfx1201.
TORCH_DEVICE=cpu

# ── Future secrets go here (kept out of git via .gitignore). ──
# DB_ENCRYPTION_KEY=
