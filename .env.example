# ── Copy to .env and adjust. docker-compose reads this automatically. ──

# Host root mounted into the api as /host. The watched folder is a SUBFOLDER of
# this — chosen by the `watchSubdir` setting, editable live from the frontend.
WATCH_ROOT=${HOME}
# Initial watched subfolder under WATCH_ROOT (seeds the DB on first run).
# e.g. "Downloads" or "Downloads/PDFs". Watched path = /host/<WATCH_SUBDIR>.
WATCH_SUBDIR=Downloads

# Where Markdown, metadata, archived PDFs and the SQLite index live.
VAULT_DIR=./vault

# The app (nginx serving the SPA + proxying to the api). Open this in a browser.
# NOTE: avoid 6665-6669 (IRC) and other ports browsers block as "unsafe"
# (ERR_UNSAFE_PORT) — curl reaches them but no browser will. 16669 is safe.
WEB_PORT=16669
# Direct API + Scalar explorer (the SPA does not need this).
API_PORT=6670

# ── These seed the settings table on first run; edit them live from the UI after. ──
# Host Ollama (Vulkan). Must be reachable from the container — see README.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Seconds a new file's size must stay stable before processing (defeats .crdownload).
DEBOUNCE_SECONDS=2

# marker-server (internal service DNS). Container shape — not a live setting.
MARKER_URL=http://marker-server:8000

# Set to "cuda" only after ROCm is proven on gfx1201.
TORCH_DEVICE=cpu

# ── Auth / secrets (REQUIRED in production — keep out of git via .gitignore) ──
# JWT signing key for login tokens. MUST be a long, random secret on a public VPS —
# anyone who knows it can mint valid tokens. Generate one with:
#   openssl rand -base64 48
# If left empty, the api generates a random keyfile under the vault (vault/.jwtkey),
# which works locally but means tokens are invalidated if the vault is wiped.
JWT_KEY=

# Master key for encrypting at-rest secrets (the per-user LLM API keys). Same idea:
# set a strong random value on the VPS; empty falls back to vault/.secretkey.
# App__SecretKey is the env name the api binds.
APP_SECRET_KEY=
